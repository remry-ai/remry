{
  "name": "remry",
  "version": "0.14.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "start": "HOST=127.0.0.1 PORT=5173 BODY_SIZE_LIMIT=25M bun build/index.js",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc --noEmit -p tsconfig.scripts.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "echo 'lint: no config yet \u2014 skipping (add eslint.config.js when ready)'",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "APP_ENV=test vitest run --config vitest.integration.config.ts",
    "db:migrate": "bunx prisma migrate dev",
    "db:studio": "bunx prisma studio",
    "prepare": "svelte-kit sync",
    "backup": "bun scripts/backup/main.ts",
    "setup": "bun scripts/setup/main.ts",
    "release:version": "bun scripts/release/version.ts",
    "license:keygen": "bun scripts/license/keygen.ts",
    "license:issue": "bun scripts/license/issue.ts",
    "license:revoke": "bun scripts/license/revoke.ts",
    "release:build": "bun scripts/release/build.ts",
    "release:package": "bun scripts/release/package.ts",
    "release:smoke": "bun scripts/release/smoke.ts",
    "desktop:prepare": "bun scripts/desktop-prepare.ts",
    "desktop:dev": "cd desktop && tauri dev",
    "desktop:build": "cd desktop && tauri build",
    "icons": "bun scripts/icons/render.ts",
    "remry": "bun cli/main.ts"
  },
  "dependencies": {
    "@libsql/client": "^0.15.15",
    "@milkdown/core": "^7.21.1",
    "@milkdown/ctx": "^7.21.1",
    "@milkdown/kit": "^7.21.1",
    "@milkdown/plugin-listener": "^7.21.1",
    "@milkdown/preset-commonmark": "^7.21.1",
    "@milkdown/preset-gfm": "^7.21.1",
    "@milkdown/prose": "^7.21.1",
    "@milkdown/transformer": "^7.21.1",
    "@prisma/adapter-libsql": "7.8.0",
    "@prisma/client": "^7.8.0",
    "@trpc/client": "^11.0.0",
    "@trpc/server": "^11.0.0",
    "chart.js": "^4.5.1",
    "html2canvas-pro": "^2.4.4",
    "jspdf": "^4.2.1",
    "marked": "^18.0.2",
    "mermaid": "^11.15.0",
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@sveltejs/adapter-node": "^5.2.0",
    "@sveltejs/kit": "^2.5.0",
    "@sveltejs/vite-plugin-svelte": "^4.0.0",
    "@tauri-apps/cli": "^2.12.0",
    "@types/bun": "latest",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-svelte": "^2.44.0",
    "prettier": "^3.3.0",
    "prettier-plugin-svelte": "^3.2.0",
    "prisma": "^7.8.0",
    "sass": "^1.77.0",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "bun": ">=1.1.0"
  }
}
