{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Remry",
  "version": "../../package.json",
  "identifier": "dev.jweatherby.remry",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "nsis"
    ],
    "category": "Productivity",
    "shortDescription": "A local, structured notebook that your AI assistant writes to over MCP",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/remry"
    ],
    "resources": {
      "resources/migrations/": "migrations/",
      "resources/VERSION": "VERSION"
    },
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "12.0"
    },
    "createUpdaterArtifacts": false,
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRFMkE1NDAwNDcxOTE2N0EKUldSNkZobEhBRlFxVG14WG1Ocng0YUw0REJlM3VEZjRXbks1K0FkYjl3UTJsdG10eGpRbmRmWVYK",
      "endpoints": [
        "https://github.com/remry-ai/remry/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
